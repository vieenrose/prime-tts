+/* One step of a device-resident conv chain: no staging copy in, no copy out, no sync when the chain
+ * continues. Returns -1 when the shape is not supported by the chained kernel, in which case the
+ * caller falls back to the plain padded path. */
+int pt_v21_conv_chain(pt_ctx *c, const float *dx_dev, int64_t tin, int cin, float **dy_dev, int cout,
+                      int K, int stride, int pad, int dil, const float *bias, int64_t batch, int wtab,
+                      int btab, int epi0, int epi1, float ea0, float ea1, int final, float *Y_host,
+                      int64_t Tout) {
+  if (!c->use_cuda || !gpu_on("conv"))
+    return -1;
+  int cout4 = (cout + 3) / 4 * 4;
+  size_t wsm_bytes = (size_t) K * cin * sizeof(float4);
+  if (wsm_bytes == 0 || wsm_bytes > 16384)
+    return -1;   /* chained path uses the staged kernel only */
+  size_t yb = (size_t) batch * cout4 * Tout * 4;
+  float *dy = (float *) arena_alloc(c, yb);
+  if (!dy)
+    return -1;
+  float *dw = (float *) weight_ctab(wtab);
+  float *db = bias ? (float *) weight_ctab(btab) : NULL;
+  if (!dw || (bias && !db)) {
+    arena_release(c, arena_mark(c));
+    return -1;
+  }
+  c->n_conv++;
+  *dy_dev = dy;
+  int threads = 256;
+  dim3 grid((unsigned) ((Tout + threads - 1) / threads), (unsigned) (cout4 / 4), (unsigned) batch);
+  double tA = gpu_prof() ? gpu_now() : 0.0;
+  pt_conv_kernel_wsb<<<grid, threads, wsm_bytes, (cudaStream_t) c->g_stream>>>(
+      dx_dev, tin /*rows are unpadded: ldx == tin*/, cin, tin, K, dil, stride, pad, dy, /*ldy=*/Tout,
+      /*Tout=*/Tout, cout, dw, db, (int64_t) cin * tin, (int64_t) cout4 * Tout, epi0, epi1, ea0, ea1);
+  if (final) {
+    PTCHK(cudaMemcpyAsync(Y_host, dy, yb, cudaMemcpyDeviceToHost, (cudaStream_t) c->g_stream));
+    PTCHK(cudaStreamSynchronize((cudaStream_t) c->g_stream));
+    if (c->chain_mark) {
+      arena_release(c, c->chain_mark);
+      c->chain_mark = NULL;
+    }
+  }
+  if (gpu_prof())
+    c->g_kernel_ms += gpu_now() - tA;
+  return 0;
+}
