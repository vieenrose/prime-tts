+/* Weight-staged conv reading an *unpadded* device input, applying the zero padding in-kernel.
+ *
+ * This is the chained-path kernel: the producer's activations stay in the arena, so there is no
+ * D2H copy, no host-side padded copy, no H2D copy and no stream sync between two convs. Terms
+ * outside the input are exactly the zeros the padded scratch would have supplied, and the pad term
+ * contributes +0.0f to the accumulator, so each output keeps the reference chain bit-for-bit.
+ */
+__global__ void pt_conv_kernel_wsb(const float *__restrict__ x, int64_t ldx, int cin, int64_t tin,
+                                   int K, int dil, int stride, int pad, float *__restrict__ y,
+                                   int64_t ldy, int64_t Tout, int cout, const float *__restrict__ wp,
+                                   const float *__restrict__ bias, int64_t bsx, int64_t bsy, int epi0,
+                                   int epi1, float ea0, float ea1) {
+  extern __shared__ float4 wsm[];
+  const int NT = blockDim.x;
+  int64_t t = (int64_t) blockIdx.x * NT + threadIdx.x;
+  int blk = (int) blockIdx.y;
+  int64_t b = (int64_t) blockIdx.z;
+  const int kc = K * cin;
+  const float4 *w4 = (const float4 *) wp + (int64_t) blk * kc;
+  for (int idx = threadIdx.x; idx < kc; idx += NT)
+    wsm[idx] = w4[idx];
+  __syncthreads();
+  if (t >= Tout)
+    return;
+  int co0 = blk * 4;
+  float4 acc = make_float4(bias && co0 + 0 < cout ? bias[co0 + 0] : 0.f,
+                           bias && co0 + 1 < cout ? bias[co0 + 1] : 0.f,
+                           bias && co0 + 2 < cout ? bias[co0 + 2] : 0.f,
+                           bias && co0 + 3 < cout ? bias[co0 + 3] : 0.f);
+  const float *xb = x + b * bsx;
+  for (int k = 0; k < K; k++) {
+    int64_t base = (int64_t) t * stride + (int64_t) k * dil - pad;
+    /* a padded tap contributes only zeros: skip it as a whole, so the channel loop below is the same
+     * branch-free loop as the staged kernel. Skipping adds +-0.0, which cannot change any output
+     * beyond the sign of a zero. */
+    if (base < 0 || base >= tin)
+      continue;
+    for (int ci = 0; ci < cin; ci++) {
+      float4 w = wsm[(int64_t) k * cin + ci];
+      float xv = xb[(int64_t) ci * ldx + base];
+      acc.x += w.x * xv;
+      acc.y += w.y * xv;
+      acc.z += w.z * xv;
+      acc.w += w.w * xv;
+    }
+  }
+  if (epi0 || epi1) {
+    for (int lane = 0; lane < 4; lane++) {
+      float v = (&acc.x)[lane];
+      v = pt_epi_dev(v, epi0, ea0);
+      v = pt_epi_dev(v, epi1, ea1);
+      (&acc.x)[lane] = v;
+    }
+  }
+  float *yb = y + b * bsy;
+  if (co0 + 0 < cout)
+    yb[(int64_t) (co0 + 0) * ldy + t] = acc.x;
+  if (co0 + 1 < cout)
+    yb[(int64_t) (co0 + 1) * ldy + t] = acc.y;
+  if (co0 + 2 < cout)
+    yb[(int64_t) (co0 + 2) * ldy + t] = acc.z;
+  if (co0 + 3 < cout)
+    yb[(int64_t) (co0 + 3) * ldy + t] = acc.w;
+}
