diff --git a/runtime/v21/Makefile b/runtime/v21/Makefile
index 1ad53a4..7ba9425 100644
--- a/runtime/v21/Makefile
+++ b/runtime/v21/Makefile
@@ -5,11 +5,14 @@
 CC      ?= gcc
 NVCC    ?= /usr/local/cuda/bin/nvcc
 PY      ?= .venv/bin/python
-CFLAGS  ?= -O2 -std=gnu11 -Wall -Wextra -Wno-unused-parameter -Wno-sign-compare
